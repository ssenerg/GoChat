<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The app and its broadcast extension share a container, where the screen passes between them. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.$(GOCHAT_BUNDLE_ID)</string>
	</array>
</dict>
</plist>
