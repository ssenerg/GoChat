<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Voice channels: the phone in a call, and a call that goes on in the background. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- The camera and the screen, in voice channels, which go on in the background too. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application>
        <service
            android:name="io.github.ssenerg.gochat.ui.VoiceCallService"
            android:exported="false"
            android:foregroundServiceType="microphone|camera|mediaProjection" />

        <!-- Hands downloaded attachments to other apps to open. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.gochat.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/gochat_files" />
        </provider>
    </application>
</manifest>
