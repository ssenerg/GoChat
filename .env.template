# Registry prefix for every image, with its trailing slash.
DOCKER_REGISTRY=docker.io/

CONFIG_ENV_PREFIX=
CONFIG_PATH=config

# Scylla: an admin role for setup and migrations, and the app's role, which
# may only read and write its keyspace. Role names: a-z, 0-9 and _.
DATABASE_SCYLLA_ADMIN_USERNAME=<string>
DATABASE_SCYLLA_ADMIN_PASSWORD=<string>
DATABASE_SCYLLA_USERNAME=<string>
DATABASE_SCYLLA_PASSWORD=<string>
# MinIO: its root account, and the app's account, limited to its bucket.
MINIO_ROOT_USER=<string>
MINIO_ROOT_PASSWORD=<string>
STORAGE_MINIO_ACCESS_KEY=<string>
STORAGE_MINIO_SECRET_KEY=<string>

# Shared by the server and its web gateways: at least 32 characters.
GATEWAY_KEY=<string>
# Shared by the server and its voice servers, and different from
# GATEWAY_KEY: `openssl rand -hex 32`. Without it voice channels are off.
VOICE_SERVER_KEY=<string>
# Seals TOTP secrets at rest: `openssl rand -base64 32`.
SERVICES_ACCOUNTS_SECRET_KEY=<base64 32 bytes>
# Required to create the first (admin) account: without it no account can
# be created. `openssl rand -hex 24`; it is not needed once that account exists.
SERVICES_ACCOUNTS_SETUP_TOKEN=

# The origin browsers use; https behind a TLS-terminating proxy or tunnel.
WEB_PUBLIC_URL=http://localhost:8080
# Where the web gateway listens on the host. 127.0.0.1 accepts only this
# machine, e.g. a reverse proxy or tunnel; 0.0.0.0 accepts everyone.
WEB_BIND=127.0.0.1
WEB_PORT=8080
# Behind a proxy on the host, the addresses its requests come from, so rate
# limits see clients: 172.16.0.0/12 covers Docker's default networks.
WEB_TRUSTED_PROXIES=

# Voice channels. Browsers open the voice server's signaling websocket at
# VOICE_PUBLIC_URL: route it through the same proxy as the web gateway, e.g.
# wss://chat.example.com/rtc to VOICE_BIND:VOICE_PORT, or give it a host of
# its own and list that origin in WEB_VOICE_ORIGINS. For phones on the local
# network, see "The Docker stack, for a phone" in mobile/README.md.
VOICE_PUBLIC_URL=ws://localhost:8090/rtc
WEB_VOICE_ORIGINS=ws://localhost:8090
VOICE_BIND=127.0.0.1
VOICE_PORT=8090
# The voice itself flows over this port, UDP and TCP, which browsers must
# reach directly (no proxy) at VOICE_PUBLIC_IP, the server's public address:
# open it in the firewall. Left empty, the voice server announces its
# container's addresses, which only browsers on this (Linux) machine reach.
# Keep the port below 32768: the system lends higher ones to outgoing
# connections, and one held that way stops the voice server starting.
VOICE_PUBLIC_IP=
VOICE_MEDIA_PORT=7882
# Optional: a TURN server sharing this secret (coturn's use-auth-secret), for
# browsers whose networks block the media port. Comma-separated URLs, e.g.
# turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349
VOICE_TURN_URLS=
VOICE_TURN_SECRET=

# Optional: push notifications to the Android and iOS apps while they are
# closed (see "Push notifications" in README.md). FCM takes a service
# account's JSON key on one line (`jq -c . key.json`); APNs a .p8 signing
# key, its id, the Apple team's id and the app's bundle id. The server then
# needs outbound access: add it to the frontend network in the compose file.
SERVICES_PUSH_FCM_CREDENTIALS=
SERVICES_PUSH_APNS_KEY=
SERVICES_PUSH_APNS_KEY_ID=
SERVICES_PUSH_APNS_TEAM_ID=
SERVICES_PUSH_APNS_TOPIC=
